# ── Database (Supabase Postgres) ────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
#
# DATABASE_URL must be a POOLED connection (port 6543, `?pgbouncer=true`).
# Serverless functions open a connection per cold start, and the direct
# connection limit is reached quickly without the pooler in front.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL is the session connection (port 5432). Prisma Migrate needs it for
# DDL, which poolers cannot run. Not used at runtime.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# auto | on | off — 'auto' enables SSL for everything except localhost.
DATABASE_SSL=auto

# ── Auth ────────────────────────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_DAYS=30

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated browser origins. Two features fetch from the browser (the
# price chart and the command palette), so the deployed frontend origin MUST be
# listed in production or they fail with an opaque CORS error.
#
# A leading `*.` matches any subdomain, which is how Vercel preview deployments
# (fresh hostname each time) keep working. Wildcards are https-only.
#   CORS_ORIGINS=https://rielvest.vercel.app,*.vercel.app
CORS_ORIGINS=http://localhost:3000

# ── Market data ─────────────────────────────────────────────────────────────
MEF_API_BASE=https://data.mef.gov.kh/api/v1
CSX_WEB_API_BASE=https://csx.com.kh/api/v1/website
CSX_CHART_API_BASE=https://api.csx.com.kh/tradingview/api/v1
CSX_CHART_ACCESS_TOKEN=AacCeEsStOk3n1

# In-process scheduler. Ignored on Vercel, where Vercel Cron drives refreshes.
INGESTION_ENABLED=true
INGESTION_INTERVAL_MINUTES=60

# ── AI narrative layer (optional) ───────────────────────────────────────────
# Free key from https://aistudio.google.com/apikey. Leave blank and the app
# uses the analysis engine's own sentences — a fully supported configuration.
#
# The model only rewrites the computed analysis; every figure it writes is
# checked against the data it was given, and unsourced numbers are discarded.
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.8-flash

# ── Vercel only ─────────────────────────────────────────────────────────────
# Shared secret for the scheduled refresh. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`. Without it the endpoint refuses to run.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""
